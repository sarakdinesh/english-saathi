{
  "expo": {
    "name": "English Saathi",
    "slug": "english-saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F8F2",
    "android": {
      "package": "com.englishsaathi.learn",
      "adaptiveIcon": {
        "backgroundColor": "#173D35"
      }
    },
    "web": {
      "name": "English Saathi",
      "bundler": "metro"
    },
    "plugins": [
      ["expo-notifications", { "color": "#174C3C" }],
      [
        "expo-audio",
        {
          "microphonePermission": "तुमचा बोलण्याचा सराव रेकॉर्ड करण्यासाठी मायक्रोफोनची परवानगी द्या.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
