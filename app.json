{
  "expo": {
    "name": "English Boluya",
    "slug": "english-saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#FEFDF5" },
    "backgroundColor": "#F7F8F2",
    "android": {
      "package": "com.englishsaathi.learn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFDF5"
      }
    },
    "web": {
      "name": "English Boluya",
      "bundler": "metro"
    },
    "plugins": [
      ["expo-notifications", { "color": "#174C3C" }],
      [
        "expo-audio",
        {
          "microphonePermission": "तुमचा बोलण्याचा सराव रेकॉर्ड करण्यासाठी मायक्रोफोनची परवानगी द्या.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
