# Google Play listing URL. Leave empty to show “Coming soon” on the Play CTA.
VITE_PLAY_STORE_URL=

# Support / contact email shown in the footer and legal pages.
VITE_SUPPORT_EMAIL=support@example.com

# Optional waitlist form endpoint (Formspree, etc.).
# If empty, the form opens a mailto: draft to VITE_SUPPORT_EMAIL.
VITE_WAITLIST_ENDPOINT=
